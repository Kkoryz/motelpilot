---
import type { IconListBlock } from '../../lib/authoring';
import Eyebrow from './Eyebrow.astro';
import InlineText from '../blog/InlineText.astro';
import TextFlow from './TextFlow.astro';

interface Props { block: IconListBlock; variant?: string }
const { block, variant = 'checks' } = Astro.props;
const hasIntro = Boolean(block.heading || block.paragraphs);
// An item without a heading among items with headings is a note to them: it runs the list's full width after them
// (site10's packaging list ended in one, and its text sat beside a two-line heading at another height).
const headed = block.items.some((item) => item.heading);
const listed = headed ? block.items.filter((item) => item.heading) : block.items;
const notes = headed ? block.items.filter((item) => !item.heading) : [];
// Two columns for an even count of short items only: beside an introduction the list has about half the container, so
// two columns there hold a few words each; without one, a sentence or two each (the hotel site's style board: detailed
// items squeezed into two narrow columns, and a split list read as three columns).
const ICON_LIST_TWO_COLUMN_CHARS = { split: 60, list: 160 };
const longest = Math.max(0, ...listed.map((item) => `${item.heading ?? ''} ${item.text}`.trim().length));
const columns = listed.length % 2 === 0 && longest <= ICON_LIST_TWO_COLUMN_CHARS[hasIntro ? 'split' : 'list'] ? 2 : 1;
---

<section class="block block--icon-list" data-authoring-block="iconList" data-block-id={block.id} data-variant={variant}>
  <div class="container icon-list" data-layout={hasIntro ? 'split' : 'list'}>
    {hasIntro && (
      <div class="icon-list__intro">
        <Eyebrow text={block.eyebrow} />
        {block.heading && <h2>{block.heading}</h2>}
        {block.paragraphs && <TextFlow paragraphs={block.paragraphs} />}
      </div>
    )}
    <ul class="icon-list__items" data-columns={columns}>
      {[...listed, ...notes].map((item) => (
        <li class:list={['icon-list__item', { 'icon-list__item--note': notes.includes(item) }]} data-explicit-span={notes.includes(item) ? 'true' : undefined}>
          <svg class="icon-list__icon" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
            {variant === 'icons'
              ? <circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2" />
              : <path d="M5 12.5l4.5 4.5L19 7.5" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />}
          </svg>
          <div>
            {item.heading && <h3>{item.heading}</h3>}
            <p><InlineText text={item.text} /></p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
