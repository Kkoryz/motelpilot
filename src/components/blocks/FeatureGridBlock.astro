---
// Equal cards. Variants: cards (template treatment), numbered (01, 02…), columns (no card chrome),
// boxed (title bar cards, e.g. contact options), media (photo on top), outline-numbered (thin-outlined rounded cards,
// a large 01 on top), icon-cards (centred cards under a round mark), bullets (no cards: the heading and lead in a left
// column, the points as a bullet list beside them, each its title then its text: the reference's service lists), icons
// (a line icon over each card's title: the cards of a site whose cards name services, scripts/lib/slot-visuals.mjs; the
// icon from the card's words, config/card-icons.json, drawn from Lucide, src/lib/lucide-icons.json).
import { cardIcon } from '../../../scripts/lib/card-icons.mjs';
import { fitRatio, usualRatio } from '../../../scripts/lib/media-ratio.mjs';
import lucide from '../../lib/lucide-icons.json';
import { density, gridPlan, variants, type FeatureGridBlock, type Media } from '../../lib/authoring';
import Eyebrow from './Eyebrow.astro';
import InlineText from '../blog/InlineText.astro';
import MediaFigure from './MediaFigure.astro';
import TextFlow from './TextFlow.astro';

interface Props { block: FeatureGridBlock; media?: Media[]; variant?: string }
const { block, media = [], variant } = Astro.props;
const pattern = variant ?? (media.length ? 'media' : 'cards');
// One frame ratio for the grid, following the photos' orientation (lib/media-ratio.mjs).
const ratio = fitRatio(usualRatio('featureGrid'), media);
const words = Math.max(...block.items.map((item) => item.wordCount ?? 0));
const grid = gridPlan(block.items.length);
// Rows each card shares with its neighbours (photo, number, title, text) so titles and text line up across a row.
const numbered = pattern === 'numbered' || pattern === 'outline-numbered';
// Icon cards: each card's icon (null: none, and no row for it when no card has one).
const icons = pattern === 'icons' ? block.items.map((item) => { const name = cardIcon(item); return name ? (lucide.icons as Record<string, string>)[name] ?? null : null; }) : [];
const cardRows = (media.length ? 1 : 0) + (numbered || pattern === 'icon-cards' || icons.some(Boolean) ? 1 : 0) + 2;
// Card titles sit one level below the grid's own title; without one, each card is a page section (h2).
const Title = block.heading ? 'h3' : 'h2';
// Numbered cards are an ordered list, so their order reaches assistive technology, not only the visual 01/02.
const List = numbered ? 'ol' : 'div';
const Item = numbered ? 'li' : 'article';
---

<section class="block block--grid" data-authoring-block="featureGrid" data-block-id={block.id} data-continues={block.continues} data-variant={variants.featureGrid} data-pattern={pattern}>
  {pattern === 'bullets' ? (
  <div class="container point-list" data-layout="split" data-continues={block.continues ? '' : undefined}>
    <div class="point-list__intro">
      <Eyebrow text={block.eyebrow} />
      {block.heading && <h2 class="feature-grid__heading">{block.heading}</h2>}
      {block.paragraphs?.map((paragraph) => <p class="block__lead"><InlineText text={paragraph} /></p>)}
    </div>
    <ul class="point-list__items" data-columns={block.items.length > 6 ? 2 : 1}>
      {block.items.map((item) => (
        <li class="point-list__item"><Title class="point-list__title">{item.heading}</Title>{item.paragraphs.map((paragraph) => <p><InlineText text={paragraph} /></p>)}</li>
      ))}
    </ul>
  </div>
  ) : (
  <div class="container">
    <Eyebrow text={block.eyebrow} />
    {block.heading && <h2 class="feature-grid__heading">{block.heading}</h2>}
    {block.paragraphs?.map((paragraph) => <p class="block__lead"><InlineText text={paragraph} /></p>)}
    <List class="feature-grid" data-layout="equal-grid" data-columns={grid.columns} data-density={density(words)} style={`${grid.style}; --card-rows: ${cardRows}`}>
      {block.items.map((item, index) => (
        <Item class="feature-card" data-explicit-span={block.span ? 'true' : undefined} style={block.span ? `grid-column: span ${block.span}` : grid.itemStyle(index)}>
          {media[index] && <MediaFigure media={media[index]} ratio={ratio} class="feature-card__media" />}
          {numbered && <span class="feature-card__number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>}
          {pattern === 'icon-cards' && <span class="feature-card__mark" aria-hidden="true"></span>}
          {/* A card without an icon keeps the icon row empty, so the titles of a row stay level. */}
          {icons.some(Boolean) && <span class="feature-card__icon" aria-hidden="true">{icons[index] && <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" focusable="false" set:html={icons[index]} />}</span>}
          <Title class="feature-card__title">{item.heading}</Title>
          <TextFlow paragraphs={item.paragraphs} maxWords={40} />
        </Item>
      ))}
    </List>
  </div>
  )}
</section>
